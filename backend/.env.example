# Node Environment
NODE_ENV=development
PORT=5000

# Database Client Provider: 'auto' | 'pg' | 'pglite'
# - 'auto': tries pg (PostgreSQL on DB_HOST:DB_PORT), falls back to embedded pglite
# - 'pg': strictly uses pg.Pool (requires PostgreSQL running via Docker or locally)
# - 'pglite': uses embedded PostgreSQL 16 engine with persistent disk storage in ./data/pgdata
DB_CLIENT=auto

# PostgreSQL Connection Settings (Used when running with Docker or local PostgreSQL service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syncproof_db
DB_USER=syncproof_user
DB_PASSWORD=syncproof_dev_password
DB_SSL=false

# Embedded PostgreSQL Data Directory (Defaults to %LOCALAPPDATA%/syncproof_pgdata to prevent OneDrive sync locking)
# PGLITE_DATA_DIR=./data/pgdata

# JWT Authentication (for future Milestone 2)
JWT_SECRET=dev_jwt_secret_change_in_production_12345
JWT_EXPIRES_IN=24h

# Client Application URL
CLIENT_URL=http://localhost:5173
