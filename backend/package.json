{
  "name": "syncproof-backend",
  "version": "1.0.0",
  "description": "Backend API and database engine for SyncProof offline-first inspection app",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:verify": "node src/db/verify.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js"
  },
  "keywords": [
    "offline-first",
    "postgresql",
    "sync",
    "inspection"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
